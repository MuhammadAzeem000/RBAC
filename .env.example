# Copy this file to .env (same directory as docker-compose.yml) and fill in
# real values before running `docker compose up`. Never commit the real .env.

# Postgres (used by the postgres and backend services)
DB_USER=commtel
DB_PASSWORD=change_me
DB_NAME=rbac_db

# Backend auth secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# integration-service (Phase 3, connector runtime):
# CREDENTIAL_ENCRYPTION_KEY encrypts connector credentials (Slack bot
# tokens, VirusTotal API keys, ...) at rest — generate with: openssl rand -hex 32
# INTEGRATION_SERVICE_TOKEN is a shared secret between playbook-service and
# integration-service for the one machine-to-machine route Temporal
# Activities call — generate with: openssl rand -hex 24
CREDENTIAL_ENCRYPTION_KEY=change_me_to_a_long_random_secret_min_32_chars
INTEGRATION_SERVICE_TOKEN=change_me_to_a_different_long_random_secret

# incident-service / playbook-service (Phase 5.2): shared secrets guarding
# each service's one machine-to-machine route — INCIDENT_SERVICE_TOKEN for
# incident-service's POST .../timeline (called by playbook-service's
# Temporal Activities), PLAYBOOK_SERVICE_TOKEN for playbook-service's
# POST .../playbook-runs/system (called by incident-service's
# alert-ingested consumer for triggerPlaybookKey) — generate with:
# openssl rand -hex 24
INCIDENT_SERVICE_TOKEN=change_me_to_a_different_long_random_secret
PLAYBOOK_SERVICE_TOKEN=change_me_to_a_different_long_random_secret

# alert-ingestion-service (Phase 5.3): shared secret guarding its
# POST .../alerts/system route, called by normalization-service once it's
# parsed a vendor SIEM/EDR webhook — generate with: openssl rand -hex 24
ALERT_INGESTION_SERVICE_TOKEN=change_me_to_a_different_long_random_secret

# threat-intelligence-service: STIX/TAXII 2.1 feed ingestion, IOC store, and
# lookup API. THREAT_INTELLIGENCE_SERVICE_TOKEN guards its machine-to-machine
# GET .../service/iocs/lookup route (called by a future connector/enrichment
# consumer) — generate with: openssl rand -hex 24. It has its own
# CREDENTIAL_ENCRYPTION_KEY for encrypting TAXII server credentials at rest,
# same purpose as integration-service's own copy above but a separate secret
# per service.
THREAT_INTELLIGENCE_SERVICE_TOKEN=change_me_to_a_different_long_random_secret
THREAT_INTEL_CREDENTIAL_ENCRYPTION_KEY=change_me_to_a_long_random_secret_min_32_chars

# Must match wherever the frontend is actually served from. Both origins are
# listed (comma-separated — the backend splits this) so the same .env works
# for both docker-compose.yml's nginx-served build (:8081) and
# docker-compose.dev.yml's hot-reload Vite dev server (:5173).
CORS_ORIGIN=http://localhost:8081,http://localhost:5173

# Frontend — baked into the static build at image build time (Vite env
# vars are not readable at container runtime), so this must point wherever
# the browser can reach the backend. The frontend only ever talks to
# api-gateway (never identity-service or incident-service directly), so
# this is the gateway's published host port.
VITE_API_BASE_URL=http://localhost:8090/api

# notification-service — the "from" address on welcome emails. In this
# dev/docker setup emails are caught by Mailpit (http://localhost:8025),
# never sent to a real inbox, so this can stay as-is.
SMTP_FROM=SOAR Console <noreply@rbac.local>
