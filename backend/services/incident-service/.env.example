PORT=4200
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USER=commtel
DB_PASSWORD=change_me
# A genuinely separate database from identity-service's — for local
# (non-Docker) dev, create it once yourself: `psql -U <user> -d postgres -c
# "CREATE DATABASE incident_db;"`. Docker Compose creates it automatically
# on a fresh volume via backend/postgres-init/.
DB_NAME=incident_db
# Must match identity-service's JWT_ACCESS_SECRET exactly — this service
# verifies tokens identity-service issues, it never issues its own.
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret_min_32_chars
IDENTITY_SERVICE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
RABBITMQ_URL=amqp://localhost:5672
