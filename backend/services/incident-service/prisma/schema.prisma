generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Aggregate root. owner_user_id/created_by/updated_by reference identity-service's
// User.id, but this service has no FK to identity-service's database (separate
// database, separate service) — those are plain BigInt columns, resolved to
// display names by the frontend calling identity-service directly. tenantId
// is the same: a plain validated BigInt (from the caller's JWT), not an FK —
// identity-service's Tenant table lives in a different database entirely.
model Incident {
  id BigInt @id @default(autoincrement())

  tenantId BigInt @map("tenant_id")

  externalId  String? @map("external_id") @db.VarChar(100)
  title       String  @db.VarChar(255)
  description String? @db.Text
  category    String? @db.VarChar(100)
  severity    String  @db.VarChar(20)
  priority    String? @db.VarChar(20)
  status      String  @default("new") @db.VarChar(30)
  tags        Json?   @db.Json

  source      String? @db.VarChar(100)
  ownerUserId BigInt? @map("owner_user_id")

  detectedAt DateTime? @map("detected_at") @db.Timestamp(6)
  dueAt      DateTime? @map("due_at") @db.Timestamp(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamp(6)
  closedAt   DateTime? @map("closed_at") @db.Timestamp(6)

  closureCode       String? @map("closure_code") @db.VarChar(50)
  resolutionSummary String? @map("resolution_summary") @db.Text
  rootCause         String? @map("root_cause") @db.Text

  createdBy BigInt  @map("created_by")
  updatedBy BigInt? @map("updated_by")
  version   Int     @default(1)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  alerts         Alert[]
  tasks          Task[]
  evidence       Evidence[]
  comments       Comment[]
  playbookRuns   PlaybookRun[]
  timelineEvents TimelineEvent[]

  @@index([tenantId])
  @@index([status])
  @@index([severity])
  @@index([ownerUserId])
  @@index([createdAt])
  @@map("incidents")
}

// Immutable source context once attached — analyst annotations belong to the
// incident (comments/notes), never to the alert row itself.
// Two ways a row here comes to exist: attachAlert (a human linking a
// related alert to an incident that already exists — summary required,
// severity/occurredAt/rawRef left null) and ingestAlert (Phase 5: a real
// alert arriving via POST /api/v1/alerts, which creates the Incident AND
// this row together — severity/occurredAt/rawRef populated from the
// canonical @responderx/shared Alert shape, summary synthesized since the
// canonical shape has no such field). @@unique below is the concrete dedup
// mechanism ingestAlert relies on: the same (source, externalId) arriving
// twice returns the existing row instead of creating a duplicate incident.
model Alert {
  id         BigInt @id @default(autoincrement())
  tenantId   BigInt @map("tenant_id")
  incidentId BigInt @map("incident_id")

  externalAlertId String  @map("external_alert_id") @db.VarChar(150)
  source          String  @db.VarChar(100)
  summary         String? @db.Text
  rawPayload      Json?   @map("raw_payload") @db.Json

  severity   String?   @db.VarChar(20)
  occurredAt DateTime? @map("occurred_at") @db.Timestamp(6)
  rawRef     String?   @map("raw_ref") @db.VarChar(500)

  attachedBy BigInt   @map("attached_by")
  attachedAt DateTime @default(now()) @map("attached_at") @db.Timestamp(6)

  incident Incident @relation(fields: [incidentId], references: [id])
  entities Entity[]

  @@unique([tenantId, source, externalAlertId])
  @@index([tenantId])
  @@index([incidentId])
  @@map("incident_alerts")
}

// A normalized indicator referenced by an alert (MVP plan §4's Entity row —
// mirrored in @responderx/shared's entity.ts). Persisted structurally
// rather than as opaque JSON so a future correlation/query feature
// ("every alert touching this IP") doesn't need a schema change to exist —
// not built in this phase, just not precluded by how this is stored.
model Entity {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")
  alertId  BigInt @map("alert_id")

  type       String  @db.VarChar(30)
  value      String  @db.VarChar(500)
  confidence Float?
  attributes Json?   @db.Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  alert Alert @relation(fields: [alertId], references: [id])

  @@index([tenantId])
  @@index([alertId])
  @@map("entities")
}

model Task {
  id         BigInt @id @default(autoincrement())
  tenantId   BigInt @map("tenant_id")
  incidentId BigInt @map("incident_id")

  title          String    @db.VarChar(255)
  description    String?   @db.Text
  assigneeUserId BigInt?   @map("assignee_user_id")
  dueDate        DateTime? @map("due_date") @db.Timestamp(6)
  status         String    @default("open") @db.VarChar(20)

  completedAt DateTime? @map("completed_at") @db.Timestamp(6)
  completedBy BigInt?   @map("completed_by")

  createdBy BigInt   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)

  incident Incident @relation(fields: [incidentId], references: [id])

  @@index([tenantId])
  @@index([incidentId])
  @@map("incident_tasks")
}

// Metadata + a storage reference only — actual binary content is deliberately
// out of scope for this MVP (spec: "do not place large binaries in the
// incident relational record"); storageRef is just an opaque string today.
model Evidence {
  id         BigInt @id @default(autoincrement())
  tenantId   BigInt @map("tenant_id")
  incidentId BigInt @map("incident_id")

  filename   String  @db.VarChar(255)
  fileType   String? @map("file_type") @db.VarChar(100)
  sizeBytes  BigInt? @map("size_bytes")
  storageRef String  @map("storage_ref") @db.VarChar(500)
  checksum   String? @db.VarChar(128)
  provenance String? @db.Text

  uploadedBy BigInt   @map("uploaded_by")
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamp(6)

  incident Incident @relation(fields: [incidentId], references: [id])

  @@index([tenantId])
  @@index([incidentId])
  @@map("incident_evidence")
}

model Comment {
  id         BigInt @id @default(autoincrement())
  tenantId   BigInt @map("tenant_id")
  incidentId BigInt @map("incident_id")

  authorUserId BigInt @map("author_user_id")
  body         String @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  editedAt  DateTime? @map("edited_at") @db.Timestamp(6)

  incident Incident @relation(fields: [incidentId], references: [id])

  @@index([tenantId])
  @@index([incidentId])
  @@map("incident_comments")
}

// Orchestration is real (Temporal — see src/temporal/): starting a run
// starts a durable Workflow Execution that survives a worker restart,
// instead of a detached setTimeout. Individual steps still simulate their
// action (no real connectors yet — see PLAYBOOK_SEED_DATA), but the
// execution ENGINE itself is real, matching this comment's spirit even
// though its literal wording predates Temporal. playbookVersionId pins the
// run to the exact Playbook/PlaybookVersion it started with (MVP plan's
// "version pinning" principle) — playbookKey/playbookVersion stay as a
// denormalized display snapshot, same values as the version's own key/
// version at the time. temporalWorkflowId correlates this row to its
// Workflow Execution; nullable because rows created before Temporal was
// wired in (Phase 1 smoke-testing) predate it.
model PlaybookRun {
  id         BigInt @id @default(autoincrement())
  tenantId   BigInt @map("tenant_id")
  incidentId BigInt @map("incident_id")

  playbookVersionId BigInt @map("playbook_version_id")
  playbookKey       String @map("playbook_key") @db.VarChar(100)
  playbookVersion   String @default("1.0") @map("playbook_version") @db.VarChar(20)

  temporalWorkflowId String? @map("temporal_workflow_id") @db.VarChar(255)

  state String @default("pending_approval") @db.VarChar(30)

  // Cheap denormalized "does this run need approval at all" flag for list
  // views — Phase 4 moved the actual gate(s)/decision(s)/expiry to the
  // Approval table below (one row per gate: the start, and/or individual
  // steps), which replaces this row's old approvedBy/approvedAt columns.
  requiresApproval Boolean @default(false) @map("requires_approval")

  initiatedBy BigInt    @map("initiated_by")
  startedAt   DateTime? @map("started_at") @db.Timestamp(6)
  endedAt     DateTime? @map("ended_at") @db.Timestamp(6)

  inputs         Json?   @db.Json
  outputsSummary String? @map("outputs_summary") @db.Text
  errorMessage   String? @map("error_message") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  incident       Incident        @relation(fields: [incidentId], references: [id])
  version        PlaybookVersion @relation(fields: [playbookVersionId], references: [id])
  stepExecutions StepExecution[]
  approvals      Approval[]

  @@index([tenantId])
  @@index([incidentId])
  @@index([playbookVersionId])
  @@map("incident_playbook_runs")
}

// A named, reusable approval configuration (MVP plan §5's "action
// categories classified by impact" — the classification lives on each
// PlaybookStep/PlaybookVersion via policyKey/startPolicyKey, referencing
// one of these). timeoutDuration/escalationAfter are Temporal duration
// strings (e.g. "24 hours") — same format as PLAYBOOK_APPROVAL_TIMEOUT in
// config/env.ts, consumed the same way inside src/temporal/workflows.ts.
model Policy {
  id BigInt @id @default(autoincrement())

  tenantId BigInt @map("tenant_id")

  key  String @db.VarChar(100)
  name String @db.VarChar(150)

  timeoutDuration   String  @map("timeout_duration") @db.VarChar(50)
  escalationAfter   String? @map("escalation_after") @db.VarChar(50)
  escalationChannel String? @map("escalation_channel") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("policies")
}

// One row per approval gate a Temporal workflow execution actually waited
// on — the playbook-start gate (stepKey null) or an individual step's gate
// (stepKey set). Written/read exclusively by Activities
// (src/temporal/activities.ts) and the approvals HTTP API
// (POST /api/v1/approvals/:id/decision), never directly by playbookRun
// routes — this is what replaced PlaybookRun.approvedBy/approvedAt.
model Approval {
  id BigInt @id @default(autoincrement())

  tenantId      BigInt @map("tenant_id")
  playbookRunId BigInt @map("playbook_run_id")

  stepKey   String? @map("step_key") @db.VarChar(100)
  policyKey String  @map("policy_key") @db.VarChar(100)

  requestorUserId BigInt  @map("requestor_user_id")
  approverUserId  BigInt? @map("approver_user_id")

  decision String @default("pending") @db.VarChar(20)

  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamp(6)
  decidedAt   DateTime? @map("decided_at") @db.Timestamp(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamp(6)
  escalatedAt DateTime? @map("escalated_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  playbookRun PlaybookRun @relation(fields: [playbookRunId], references: [id])

  @@index([tenantId])
  @@index([playbookRunId])
  @@index([decision])
  @@map("approvals")
}

// One row per playbook step actually executed by the Temporal workflow —
// the per-step audit trail the MVP plan's domain model calls "Step
// Execution" (mirrored in @responderx/shared's execution.ts). Written by
// Activities (src/temporal/activities.ts), never directly by an HTTP route.
model StepExecution {
  id            BigInt @id @default(autoincrement())
  tenantId      BigInt @map("tenant_id")
  playbookRunId BigInt @map("playbook_run_id")

  stepKey  String @map("step_key") @db.VarChar(100)
  stepName String @map("step_name") @db.VarChar(150)
  status   String @default("pending") @db.VarChar(20)

  input  Json?   @db.Json
  output Json?   @db.Json
  error  String? @db.Text

  attempts Int @default(0)

  startedAt DateTime? @map("started_at") @db.Timestamp(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  playbookRun PlaybookRun @relation(fields: [playbookRunId], references: [id])

  @@index([tenantId])
  @@index([playbookRunId])
  @@map("step_executions")
}

// Append-only by convention — no route ever updates or deletes a row here.
// This IS the incident's audit trail as well as its UX activity feed (the
// spec explicitly describes Timeline Event as serving both purposes).
model TimelineEvent {
  id         BigInt @id @default(autoincrement())
  tenantId   BigInt @map("tenant_id")
  incidentId BigInt @map("incident_id")

  eventType   String  @map("event_type") @db.VarChar(50)
  actorUserId BigInt? @map("actor_user_id")
  summary     String  @db.Text
  metadata    Json?   @db.Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  incident Incident @relation(fields: [incidentId], references: [id])

  @@index([tenantId])
  @@index([incidentId])
  @@index([createdAt])
  @@map("incident_timeline_events")
}

// Transactional outbox for CENTRAL audit-service delivery — a separate
// concern from TimelineEvent above (which stays exactly as it is: the
// incident-scoped audit/UX trail this service's own API and frontend use).
// Only the mutations the SOAR MVP spec calls out for cross-service audit
// (incident creation/update/status/severity/assignment/closure) write here;
// tasks/evidence/comments/playbook runs are still recorded in
// TimelineEvent only, not centrally audited — see
// backend/services/audit-service and the project's audit-service memory
// for the full reasoning.
model OutboxEvent {
  id BigInt @id @default(autoincrement())

  tenantId BigInt @map("tenant_id")

  eventId       String  @unique @map("event_id") @db.VarChar(36)
  eventType     String  @map("event_type") @db.VarChar(100)
  aggregateType String  @map("aggregate_type") @db.VarChar(50)
  aggregateId   String  @map("aggregate_id") @db.VarChar(100)

  actorId   String? @map("actor_id") @db.VarChar(100)
  actorType String  @default("USER") @map("actor_type") @db.VarChar(20)

  action       String @db.VarChar(50)
  resourceType String @map("resource_type") @db.VarChar(50)
  resourceId   String @map("resource_id") @db.VarChar(100)

  metadata Json? @db.Json
  payload  Json? @db.Json

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  publishedAt DateTime? @map("published_at") @db.Timestamp(6)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.Text

  @@index([publishedAt])
  @@index([tenantId])
  @@map("outbox_events")
}

// Versioned playbook definitions, replacing the hardcoded PLAYBOOK_CATALOG
// constant. `steps` stays an opaque JSON array in Phase 1 — the real
// DAG/step model (conditions, parallel branches, retries) is Phase 2's
// concern once a durable workflow engine is chosen; this only needs to make
// the catalog real, DB-backed, and versioned.
model Playbook {
  id BigInt @id @default(autoincrement())

  tenantId BigInt @map("tenant_id")

  key         String  @db.VarChar(100)
  name        String  @db.VarChar(150)
  description String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  versions PlaybookVersion[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("playbooks")
}

// Immutable once created — a PlaybookRun stays bound to the exact version it
// started with (MVP plan's "version pinning" principle), even if a newer
// version is published later.
model PlaybookVersion {
  id BigInt @id @default(autoincrement())

  tenantId   BigInt @map("tenant_id")
  playbookId BigInt @map("playbook_id")

  version          String  @db.VarChar(20)
  requiresApproval Boolean @default(false) @map("requires_approval")
  // The Policy (by key) gating this version's run before its first step —
  // null means no start gate. Individual steps can carry their own
  // policyKey too (inside `steps`' JSON) for a mid-run gate.
  startPolicyKey   String? @map("start_policy_key") @db.VarChar(100)
  steps            Json    @default("[]") @db.Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  playbook     Playbook      @relation(fields: [playbookId], references: [id])
  playbookRuns PlaybookRun[]

  @@unique([playbookId, version])
  @@index([tenantId])
  @@map("playbook_versions")
}
