generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Every business user, department, and role assignment belongs to exactly
// one Tenant. Platform Operator accounts still carry a (home) tenantId like
// everyone else — their cross-tenant access is a role-based exemption
// applied by the tenant-scoping helper (@responderx/shared), not a null
// tenant on the row. Role/Module/Action/Permission/RolePermission stay
// global platform taxonomy (see the comment on Role below) and are
// deliberately NOT tenant-scoped.
model Tenant {
  id BigInt @id @default(autoincrement())

  slug String @db.VarChar(63)
  name String @db.VarChar(150)

  status String @default("active") @db.VarChar(30)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)

  users           User[]
  departments     Department[]
  userRoles       UserRole[]
  userDepartments UserDepartment[]

  @@unique([slug])
  @@index([status])
  @@map("tenants")
}

model User {
  id BigInt @id @default(autoincrement())

  tenantId BigInt @map("tenant_id")

  name         String  @db.VarChar(150)
  email        String  @db.VarChar(255)
  passwordHash String? @map("password_hash") @db.VarChar(255)

  avatarUrl    String? @map("avatar_url") @db.VarChar(500)

  status          String    @default("active") @db.VarChar(30)
  isActive        Boolean   @default(true) @map("is_active")

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamp(6)
  lastLoginIp String?   @map("last_login_ip") @db.VarChar(45)

  metadata Json? @db.Json

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  userDepartments UserDepartment[]

  // Email is unique per tenant, not globally — two different tenants may
  // have a user with the same corporate email colliding only by coincidence.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([status])
  @@map("users")
}

model Department {
  id BigInt @id @default(autoincrement())

  tenantId BigInt @map("tenant_id")

  name        String  @db.VarChar(150)
  description String? @db.Text

  status   String  @default("active") @db.VarChar(30)
  isActive Boolean @default(true) @map("is_active")

  sortOrder Int @default(0) @map("sort_order")

  metadata Json? @db.Json

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userDepartments UserDepartment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

// Deliberately NOT tenant-scoped: the MVP plan's role list (Viewer,
// Analyst, Approver, Playbook Engineer, Tenant Admin, Platform Operator) is a
// fixed platform taxonomy, seeded once (bootstrap.service.ts /
// moduleSeed.service.ts), not something a tenant customizes. Same for
// Module/Action/Permission/RolePermission below — a tenant's users are
// assigned these global roles via UserRole (which IS tenant-scoped), so
// cross-tenant leakage isn't possible through this taxonomy even though it
// carries no tenantId of its own.
model Role {
  id BigInt @id @default(autoincrement())

  name        String  @db.VarChar(100)
  description String? @db.Text

  isSystem  Boolean @default(false) @map("is_system")
  isActive  Boolean @default(true) @map("is_active")

  metadata Json? @db.Json

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([name])
  @@index([isActive])
  @@map("roles")
}

model Module {
  id BigInt @id @default(autoincrement())

  name        String  @db.VarChar(100)
  description String? @db.Text

  icon      String? @db.VarChar(100)
  route     String? @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")

  isSystem       Boolean @default(false) @map("is_system")
  isActive       Boolean @default(true) @map("is_active")

  metadata Json? @db.Json

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  permissions Permission[]

  @@index([isActive])
  @@map("modules")
}

model Action {
  id BigInt @id @default(autoincrement())

  name        String  @db.VarChar(100)
  description String? @db.Text

  sortOrder Int @default(0) @map("sort_order")

  isActive Boolean @default(true) @map("is_active")

  metadata Json? @db.Json

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  permissions Permission[]

  @@index([isActive])
  @@map("actions")
}

model Permission {
  id BigInt @id @default(autoincrement())

  moduleId BigInt @map("module_id")
  actionId BigInt @map("action_id")

  name        String  @db.VarChar(150)
  description String? @db.Text

  isActive Boolean @default(true) @map("is_active")

  metadata Json? @db.Json

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  module Module @relation(fields: [moduleId], references: [id])
  action Action @relation(fields: [actionId], references: [id])

  rolePermissions RolePermission[]

  @@unique([moduleId, actionId])
  @@index([moduleId])
  @@index([actionId])
  @@index([isActive])
  @@map("permissions")
}

model UserRole {
  userId   BigInt @map("user_id")
  roleId   BigInt @map("role_id")
  tenantId BigInt @map("tenant_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  createdBy BigInt?  @map("created_by")

  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([tenantId])
  @@map("user_roles")
}

model UserDepartment {
  userId       BigInt @map("user_id")
  departmentId BigInt @map("department_id")
  tenantId     BigInt @map("tenant_id")

  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  createdBy BigInt?  @map("created_by")

  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  tenant     Tenant     @relation(fields: [tenantId], references: [id])

  @@id([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
  @@index([tenantId])
  @@map("user_departments")
}

model RolePermission {
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  createdBy BigInt?  @map("created_by")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Transactional outbox: every auditable mutation inserts a row here in the
// SAME database transaction as its business write, so the two can never
// diverge (a rolled-back business transaction rolls this back too). A
// separate publisher worker (outboxPublisher.service.ts) polls unpublished
// rows and delivers them to the "audit.events" exchange — nothing here ever
// calls audit-service directly or synchronously.
model OutboxEvent {
  id BigInt @id @default(autoincrement())

  tenantId BigInt @map("tenant_id")

  eventId       String  @unique @map("event_id") @db.VarChar(36)
  eventType     String  @map("event_type") @db.VarChar(100)
  aggregateType String  @map("aggregate_type") @db.VarChar(50)
  aggregateId   String  @map("aggregate_id") @db.VarChar(100)

  actorId   String? @map("actor_id") @db.VarChar(100)
  actorType String  @default("USER") @map("actor_type") @db.VarChar(20)

  action       String @db.VarChar(50)
  resourceType String @map("resource_type") @db.VarChar(50)
  resourceId   String @map("resource_id") @db.VarChar(100)

  metadata Json? @db.Json
  payload  Json? @db.Json

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  publishedAt DateTime? @map("published_at") @db.Timestamp(6)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.Text

  @@index([publishedAt])
  @@index([tenantId])
  @@map("outbox_events")
}
