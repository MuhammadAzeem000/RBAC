PORT=4400
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USER=commtel
DB_PASSWORD=change_me
# A genuinely separate database from every other service's — for local
# (non-Docker) dev, create it once yourself: `psql -U <user> -d postgres -c
# "CREATE DATABASE audit_db;"`. Docker Compose creates it automatically on a
# fresh volume via backend/postgres-init/.
DB_NAME=audit_db
# Must match identity-service's JWT_ACCESS_SECRET exactly — GET /api/audit-logs
# verifies the caller's token and checks their permissions against
# identity-service, the same pattern incident-service uses.
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret_min_32_chars
IDENTITY_SERVICE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
RABBITMQ_URL=amqp://localhost:5672
