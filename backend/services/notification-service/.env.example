PORT=4100
NODE_ENV=development
RABBITMQ_URL=amqp://localhost:5672
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=SOAR Console <noreply@rbac.local>
DB_HOST=localhost
DB_PORT=5432
DB_USER=commtel
DB_PASSWORD=change_me
# A genuinely separate database from every other service's — for local
# (non-Docker) dev, create it once yourself: `psql -U <user> -d postgres -c
# "CREATE DATABASE notification_db;"`. Docker Compose creates it
# automatically on a fresh volume via backend/postgres-init/.
DB_NAME=notification_db
